rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+%]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidFaculty(data) {
      return data.keys().hasAll(['id', 'city', 'univName', 'facultyName', 'status', 'lastUpdatedBy', 'lastUpdatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.city is string && data.city.size() <= 100
        && data.univName is string && data.univName.size() <= 200
        && data.facultyName is string && data.facultyName.size() <= 200
        && data.status in ['açıyor', 'açmıyor', 'belirsiz']
        && (!('announcementUrl' in data) || (data.announcementUrl is string && data.announcementUrl.size() <= 500))
        && (!('coursesText' in data) || (data.coursesText is string && data.coursesText.size() <= 10000))
        && (!('courses' in data) || (data.courses is list && data.courses.size() <= 200))
        && data.lastUpdatedBy is map
        && data.lastUpdatedBy.uid == request.auth.uid
        && data.lastUpdatedAt == request.time;
    }

    match /faculties/{facultyId} {
      allow read, get, list: if true;
      
      allow create: if isEmailVerified() && isValidId(facultyId) && isValidFaculty(request.resource.data);
      
      allow update: if isEmailVerified() && isValidId(facultyId) && isValidFaculty(request.resource.data);
      
      allow delete: if false; // Deleting faculties is restricted to preserve crowd-sourced directories
    }
  }
}
